# PostgreSQL
DATABASE_URL=postgres://usuario:clave@localhost:5432/zenity
PGSSL=false            # true si tu proveedor (Neon, Supabase, Render...) exige SSL

# Wompi (comercios.wompi.co > Desarrolladores > Llaves). Empieza con las de pruebas.
WOMPI_ENV=sandbox      # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# Tu sitio (sin / al final) y clave del panel /admin.html
BASE_URL=http://localhost:3000
ADMIN_TOKEN=pon-una-clave-larga-y-secreta
PORT=3000
