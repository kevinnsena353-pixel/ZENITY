# Render PostgreSQL Internal Database URL (or local PostgreSQL URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true for Render managed PostgreSQL if using its internal URL
PGSSL=true
# public origin of this service, no trailing slash, e.g. https://zenity-store.onrender.com
PUBLIC_URL=https://YOUR-SERVICE.onrender.com
# Wompi sandbox keys from your merchant dashboard (never commit real keys)
WOMPI_PUBLIC_KEY=pub_test_REPLACE_ME
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_ME
WOMPI_PRIVATE_KEY=prv_test_REPLACE_ME
WOMPI_ENV=sandbox
# Admin panel credentials (use a unique, long password)
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
